#!/usr/bin/env bash
# Random wallpaper from Prism's set.
#   prism-wall          the focused screen
#   prism-wall all      every screen
#   prism-wall DP-1     a given output
set -euo pipefail
target=${1:-}
if [[ -z $target ]]; then
    target=$(hyprctl monitors -j | python -c 'import json,sys; print(next(m["name"] for m in json.load(sys.stdin) if m["focused"]))')
elif [[ $target == all ]]; then
    target=""
fi
exec quickshell ipc -p "$HOME/.config/prism/shell" call wallpaper next "$target"
